<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consentimientos | Administración PHD</title>
  <link rel="stylesheet" href="/css/admin-privacy.css">
</head>
<body>
  <main class="admin-shell">
    <header class="page-header">
      <div>
        <div class="eyebrow">Perfil Humano Digital · Administración</div>
        <h1>Consentimientos de privacidad</h1>
        <p>
          Los participantes sintéticos se muestran por separado para no alterar
          las métricas de consentimiento de participantes reales.
        </p>
      </div>

      <div class="header-actions">
        <a class="btn secondary" href="/admin/dashboard">Volver al panel</a>
        <a
          class="btn primary"
          href="/admin/privacy/consents.csv?search=<%= encodeURIComponent(filters.search) %>&status=<%= encodeURIComponent(filters.status) %>&type=<%= encodeURIComponent(filters.type) %>"
        >
          Exportar CSV
        </a>
      </div>
    </header>

    <section class="notice-info">
      <div>
        <span class="label">Versión vigente</span>
        <strong><%= activeNotice ? activeNotice.version : 'Sin versión activa' %></strong>
      </div>
      <div>
        <span class="label">Fecha de vigencia</span>
        <strong><%= activeNotice ? activeNotice.effective_date : '—' %></strong>
      </div>
      <div>
        <span class="label">Zona horaria mostrada</span>
        <strong>Ciudad de México</strong>
      </div>
    </section>

    <section class="summary-grid">
      <article class="metric-card">
        <span>Participantes reales</span>
        <strong><%= summary.realTotal %></strong>
      </article>

      <article class="metric-card">
        <span>Consentimientos reales vigentes</span>
        <strong><%= summary.realCurrent %></strong>
      </article>

      <article class="metric-card highlight">
        <span>Porcentaje real de consentimiento</span>
        <strong><%= summary.realPercentage %>%</strong>
        <small><%= summary.realCurrent %> de <%= summary.realTotal %> participantes reales</small>
      </article>

      <article class="metric-card">
        <span>Pendientes reales</span>
        <strong><%= summary.realPending %></strong>
        <small>
          Anteriores: <%= summary.realOutdated %> · Revocados: <%= summary.realRevoked %>
        </small>
      </article>

      <article class="metric-card">
        <span>Perfiles sintéticos / prueba</span>
        <strong><%= summary.syntheticTotal %></strong>
      </article>

      <article class="metric-card">
        <span>Consentimientos simulados vigentes</span>
        <strong><%= summary.syntheticCurrent %></strong>
        <small>
          Pendientes: <%= summary.syntheticPending %>
        </small>
      </article>
    </section>

    <section class="panel">
      <form class="filters" method="GET" action="/admin/privacy/consents">
        <label>
          <span>Buscar usuario</span>
          <input
            type="search"
            name="search"
            value="<%= filters.search %>"
            placeholder="Nombre, correo o ID"
          >
        </label>

        <label>
          <span>Tipo</span>
          <select name="type">
            <option value="all" <%= filters.type === 'all' ? 'selected' : '' %>>Todos</option>
            <option value="real" <%= filters.type === 'real' ? 'selected' : '' %>>Participantes reales</option>
            <option value="synthetic" <%= filters.type === 'synthetic' ? 'selected' : '' %>>Sintéticos / prueba</option>
          </select>
        </label>

        <label>
          <span>Estado</span>
          <select name="status">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>Todos</option>
            <option value="current" <%= filters.status === 'current' ? 'selected' : '' %>>Vigente</option>
            <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pendiente</option>
            <option value="outdated" <%= filters.status === 'outdated' ? 'selected' : '' %>>Versión anterior</option>
            <option value="revoked" <%= filters.status === 'revoked' ? 'selected' : '' %>>Revocado</option>
          </select>
        </label>

        <button class="btn primary" type="submit">Filtrar</button>
        <a class="btn secondary" href="/admin/privacy/consents">Limpiar</a>
      </form>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Participante</th>
              <th>Tipo</th>
              <th>Estado</th>
              <th>Versión</th>
              <th>Aceptado (CDMX)</th>
              <th>Revocado (CDMX)</th>
            </tr>
          </thead>
          <tbody>
            <% if (!users.length) { %>
              <tr>
                <td colspan="7" class="empty">No se encontraron registros.</td>
              </tr>
            <% } %>

            <% users.forEach(user => { %>
              <tr>
                <td><%= user.user_id %></td>
                <td>
                  <div class="person">
                    <strong><%= user.name %></strong>
                    <span><%= user.email %></span>
                  </div>
                </td>
                <td>
                  <% if (user.is_synthetic) { %>
                    <span class="badge outdated">Sintético</span>
                  <% } else { %>
                    <span class="badge current">Real</span>
                  <% } %>
                </td>
                <td>
                  <% if (user.consent_status === 'current') { %>
                    <span class="badge current">Vigente</span>
                  <% } else if (user.consent_status === 'pending') { %>
                    <span class="badge pending">Pendiente</span>
                  <% } else if (user.consent_status === 'outdated') { %>
                    <span class="badge outdated">Versión anterior</span>
                  <% } else { %>
                    <span class="badge revoked">Revocado</span>
                  <% } %>
                </td>
                <td><%= user.accepted_version || '—' %></td>
                <td><%= user.accepted_at_local %></td>
                <td><%= user.revoked_at_local %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <p class="footnote">
        Los perfiles con correo @phd-sim.mx o con marca interna SIMULATED se clasifican
        como sintéticos. No se incluyen en el porcentaje de consentimiento real.
        Las fechas permanecen almacenadas en UTC y se muestran convertidas a Ciudad de México.
      </p>
    </section>
  </main>
</body>
</html>
